Package: hgwordcloud
Title: Highcharter Word Cloud Visualization Wrapper
Version: 0.0.1
Authors@R: c(
    person("Datasketch", , , "hi@datasketch.co", role = c("aut", "cre", "cph")),
    person("Camila", "Achuri", , "camila@datasketch.co", role = "aut"),
    person("Daniel", "Delgado", , "daniel.delgado@datasketch.co", role = "aut")
